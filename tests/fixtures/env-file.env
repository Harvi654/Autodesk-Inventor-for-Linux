# Edge cases for scripts/lib/bsdtar.env-style files: read the same way by
# install-from-image.py (read_env_file) and nix/env-file.nix. The expected
# values are in tests/test_bsdtar.py and in the flake check "installation".
PLAIN=value
  INDENTED = spaced value  
QUOTED="quoted value"
EMPTY=
WITH_EQUALS=a=b
DUP=first
# COMMENTED=no
not a setting
DUP=last
