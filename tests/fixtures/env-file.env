# Edge cases for files in the style of scripts/lib/bsdtar.env, which
# install-from-image.py (read_env_file) and nix/env-file.nix must read the
# same way. The expected values are in tests/test_bsdtar.py and in the flake
# check "installation".
PLAIN=value
  INDENTED = spaced value  
QUOTED="quoted value"
EMPTY=
WITH_EQUALS=a=b
DUP=first
# COMMENTED=no
not a setting
DUP=last
