# Disk space and memory the installer checks for - the one place for these
# numbers. Sourced by scripts/lib/common.sh, read by scripts/lib/requirements.py
# (install.sh, check-system.sh and the graphical installer all use that).
# Plain NAME=value lines, no shell syntax beyond that.
#
# Measured 2026-11-16 (du) on a full Inventor 2027.2 installation made by
# the installer: the prefix 20 GB (Content Center 7.4 GB, DWG TrueView and
# the Electrical Catalog Browser included; a full 2026 prefix is also
# 20 GB), the unpacked downloads in ~/.cache/inventor-on-linux/media
# 10.5 GB (base 6.5 + update 4.0, needed only while installing), winum
# 0.9 GB per release. README "Requirements".

# the Wine prefix, with and without Content Center (GB)
REQ_PREFIX_GB=20
REQ_PREFIX_NO_CONTENT_GB=13
# of which Content Center (GB) - what --no-content saves
REQ_CONTENT_GB=7.5
# the unpacked downloads (only when not unpacked already)
REQ_MEDIA_GB=11
# winum (one release), in ~/.local/share/inventor-on-linux
REQ_WINE_GB=1
# the small pinned downloads (DXVK, vkd3d-proton, .NET 4.0, WebView2, ...)
# in the project's downloads/ folder; Wine + these = 1.5 GB
REQ_DOWNLOADS_GB=0.5
# added on top of every sum
REQ_MARGIN=0.10
# a repair or a continued installation of an existing prefix
REQ_REPAIR_GB=2

# memory: MemTotal from /proc/meminfo, in GiB. A 16 GB machine reports
# about 15.x GiB. Below REQ_RAM_GIB: a warning; below REQ_RAM_LOW_GIB: a
# stronger one. Never a stop. 16 GB is Autodesk's own minimum.
REQ_RAM_GIB=15
REQ_RAM_LOW_GIB=7.5
