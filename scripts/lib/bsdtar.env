# tar.exe for the prefix: libarchive's own signed Windows build of bsdtar,
# the program Windows 10 ships as C:\Windows\System32\tar.exe (measured in
# the maintainer's VM: bsdtar 3.5.2 - libarchive 3.5.2). Inventor 2027's
# Electrical Catalog Browser unzips its library with it during the install
# (docs/installer-completeness-review.md, run 2). 3.5.3 is the last release
# with an official Windows build (libarchive-vX-win64.zip + .asc).
# Deviation from Windows: the same 64-bit bsdtar.exe also goes into
# syswow64, where Windows 10 has a 32-bit tar.exe - libarchive publishes
# win64 builds only (docs/installer-completeness-review.md).
# Read by install-from-image.py and common.sh (install_bsdtar); the Nix
# build links the same file into DOWNLOAD_DIR (nix/inventor.nix).
BSDTAR_VER=3.5.3
BSDTAR_ZIP=libarchive-v3.5.3-win64.zip
BSDTAR_URL=https://github.com/libarchive/libarchive/releases/download/v3.5.3/libarchive-v3.5.3-win64.zip
BSDTAR_SHA256=81c45c31a31a7b49809b3625594c28a1afbcc18faa6ee1d2ab4e4328ba8ef736
# bsdtar.exe inside the zip (libarchive/bin/bsdtar.exe), statically linked:
# needs only Windows' own DLLs, VCRUNTIME140 and the UCRT
BSDTAR_MEMBER=libarchive/bin/bsdtar.exe
BSDTAR_EXE_SHA256=b072373bb24396c83e56093a8842497069b9014e7dc6caec2b595ad1057ff5c2
