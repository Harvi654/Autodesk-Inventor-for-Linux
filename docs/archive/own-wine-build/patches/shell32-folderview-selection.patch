 static HRESULT WINAPI FolderView2_GetSelection(IFolderView2 *iface, BOOL none_implies_folder,
     IShellItemArray **array)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%d %p), stub\n", This, none_implies_folder, array);
-    return E_NOTIMPL;
+    IPersistFolder2 *persist;
+    ITEMIDLIST **pidls, *folder;
+    HRESULT hr;
+    int count;
+
+    TRACE("(%p)->(%d %p)\n", This, none_implies_folder, array);
+
+    if (!array) return E_POINTER;
+    *array = NULL;
+
+    if ((count = shellview_collect_items(This, TRUE, &pidls)))
+    {
+        hr = SHCreateShellItemArray(NULL, This->pSFParent, count, (LPCITEMIDLIST *)pidls, array);
+        free(pidls);
+        return hr;
+    }
+
+    if (!none_implies_folder) return E_FAIL;
+
+    hr = IShellFolder_QueryInterface(This->pSFParent, &IID_IPersistFolder2, (void **)&persist);
+    if (FAILED(hr)) return hr;
+    hr = IPersistFolder2_GetCurFolder(persist, &folder);
+    IPersistFolder2_Release(persist);
+    if (FAILED(hr)) return hr;
+    hr = SHCreateShellItemArrayFromIDLists(1, (LPCITEMIDLIST *)&folder, array);
+    ILFree(folder);
+    return hr;
 }
 
 static HRESULT WINAPI FolderView2_GetSelectionState(IFolderView2 *iface, PCUITEMID_CHILD pidl,
     DWORD *flags)
 {
     IShellViewImpl *This = impl_from_IFolderView2(iface);
-    FIXME("(%p)->(%p %p), stub\n", This, pidl, flags);
-    return E_NOTIMPL;
+    UINT state;
+    int index;
+
+    TRACE("(%p)->(%p %p)\n", This, pidl, flags);
+
+    if (!flags) return E_POINTER;
+    *flags = SVSI_DESELECT;
+    if ((index = LV_FindItemByPidl(This, pidl)) == -1) return E_INVALIDARG;
+
+    state = SendMessageW(This->hWndList, LVM_GETITEMSTATE, index, LVIS_SELECTED | LVIS_FOCUSED);
+    if (state & LVIS_SELECTED) *flags |= SVSI_SELECT;
+    if (state & LVIS_FOCUSED) *flags |= SVSI_FOCUSED;
+    return S_OK;
 }
 
