+/* Child pidls of the items in the view, all of them or only the selected ones. */
+static int shellview_collect_items(IShellViewImpl *This, BOOL selected, ITEMIDLIST ***pidls)
+{
+    int count, index = -1, i = 0;
+    LVITEMW item;
+
+    count = SendMessageW(This->hWndList, selected ? LVM_GETSELECTEDCOUNT : LVM_GETITEMCOUNT, 0, 0);
+    if (count <= 0 || !(*pidls = malloc(count * sizeof(**pidls)))) return 0;
+
+    while (i < count && (index = SendMessageW(This->hWndList, LVM_GETNEXTITEM, index,
+                                              selected ? LVNI_SELECTED : LVNI_ALL)) != -1)
+    {
+        item.mask = LVIF_PARAM;
+        item.iItem = index;
+        item.iSubItem = 0;
+        if (!SendMessageW(This->hWndList, LVM_GETITEMW, 0, (LPARAM)&item)) break;
+        (*pidls)[i++] = (ITEMIDLIST *)item.lParam;
+    }
+    if (!i) free(*pidls);
+    return i;
+}
