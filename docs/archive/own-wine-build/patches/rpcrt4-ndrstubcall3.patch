+/***********************************************************************
+ *            NdrStubCall3 [RPCRT4.@]
+ *
+ * Stub of an interface MIDL built for both NDR and NDR64 (/protocol all).
+ * Our proxies always send NDR (see ndr64_client_call), so use the NDR
+ * format strings of the interface.
+ */
+LONG WINAPI NdrStubCall3( struct IRpcStubBuffer *This, struct IRpcChannelBuffer *channel,
+                          PRPC_MESSAGE msg, DWORD *phase )
+{
+    const MIDL_SERVER_INFO *info = get_server_info( This, msg );
+    MIDL_SERVER_INFO ndr_info;
+    ULONG_PTR i;
+
+    TRACE("This %p, channel %p, msg %p, phase %p\n", This, channel, msg, phase);
+
+    for (i = 0; i < info->nCount; ++i)
+    {
+        const MIDL_SYNTAX_INFO *syntax_info = &info->pSyntaxInfo[i];
+
+        if (!memcmp( &syntax_info->TransferSyntax, &ndr_syntax_id, sizeof(RPC_SYNTAX_IDENTIFIER) ))
+        {
+            ndr_info = *info;
+            ndr_info.ProcString = syntax_info->ProcString;
+            ndr_info.FmtStringOffset = syntax_info->FmtStringOffset;
+            return ndr_stub_call( This, channel, msg, phase, &ndr_info );
+        }
+    }
+
+    if (info->ProcString && info->FmtStringOffset)
+        return ndr_stub_call( This, channel, msg, phase, info );
+
+    FIXME("NDR64 syntax is not supported.\n");
+    RpcRaiseException( RPC_X_WRONG_STUB_VERSION );
+    return 0;
+}
+
