         {
+            if (entry->released && !released_tlb_valid(entry))
+            {
+                TRACE("file changed, dropping released %p\n", entry);
+                ITypeLibImpl_Destroy(entry);
+                break;
+            }
             TRACE("cache hit\n");
             *ppTypeLib = &entry->ITypeLib2_iface;
             ITypeLib2_AddRef(*ppTypeLib);
@@ -3380,6 +3423,7 @@ static HRESULT TLB_ReadTypeLib(LPCWSTR pszFileName, LPWSTR pszPath, UINT cchPath
 	impl->path = wcsdup(pszPath);
 	/* We should really canonicalise the path here. */
         impl->index = index;
+        impl->reusable = get_file_info(pszPath, &impl->file_size, &impl->file_time);
 
         /* FIXME: check if it has added already in the meantime */
         EnterCriticalSection(&cache_section);
@@ -4818,84 +4862,124 @@ static ULONG WINAPI ITypeLib2_fnAddRef( ITypeLib2 *iface)
 
     TRACE("%p, refcount %lu.\n", iface, ref);
 
+    /* A released library is only reachable through the cache, under
+     * cache_section: it is in use again. */
+    if (ref == 1 && This->released)
+    {
+        list_remove(&This->released_entry);
+        This->released = FALSE;
+        released_count--;
+    }
+
     return ref;
 }
 
