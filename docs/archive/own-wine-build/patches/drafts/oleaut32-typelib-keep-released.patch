+static void write_reload_typelib(const WCHAR *filename, const GUID *guid, int count)
+{
+    ICreateTypeLib2 *ctl;
+    ICreateTypeInfo *cti;
+    WCHAR name[16];
+    HRESULT hr;
+    int i;
+
+    hr = CreateTypeLib2(SYS_WIN32, filename, &ctl);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    for (i = 0; i < count; ++i)
+    {
+        GUID iid = *guid;
+
+        iid.Data4[7] += i;
+        swprintf(name, ARRAY_SIZE(name), L"reload%d", i);
+        hr = ICreateTypeLib2_CreateTypeInfo(ctl, name, TKIND_INTERFACE, &cti);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        hr = ICreateTypeInfo_SetGuid(cti, &iid);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ICreateTypeInfo_Release(cti);
+    }
+    hr = ICreateTypeLib2_SaveAllChanges(ctl);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ICreateTypeLib2_Release(ctl);
+}
+
+static void test_LoadTypeLib_released(void)
+{
+    static const GUID guid1 = {0x6c1f0a11, 0x3b2e, 0x4d7a, {0x9a, 0x51, 0x0f, 0x2c, 0x5e, 0xa1, 0x00, 0x10}};
+    static const GUID guid2 = {0x6c1f0a11, 0x3b2e, 0x4d7a, {0x9a, 0x51, 0x0f, 0x2c, 0x5e, 0xa1, 0x00, 0x20}};
+    char filenameA[MAX_PATH];
+    WCHAR filenameW[MAX_PATH];
+    ITypeInfo *ti;
+    ITypeLib *tl;
+    HRESULT hr;
+    ULONG ref;
+
+    GetTempFileNameA(".", "tlb", 0, filenameA);
+    MultiByteToWideChar(CP_ACP, 0, filenameA, -1, filenameW, MAX_PATH);
+    write_reload_typelib(filenameW, &guid1, 1);
+
+    hr = LoadTypeLib(filenameW, &tl);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = ITypeLib_GetTypeInfoOfGuid(tl, &guid1, &ti);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ITypeInfo_Release(ti);
+    ref = ITypeLib_Release(tl);
+    ok(!ref, "Got refcount %lu.\n", ref);
+
+    /* the same file again after the last reference went */
+    hr = LoadTypeLib(filenameW, &tl);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(ITypeLib_GetTypeInfoCount(tl) == 1, "Got %u type infos.\n", ITypeLib_GetTypeInfoCount(tl));
+    hr = ITypeLib_GetTypeInfoOfGuid(tl, &guid1, &ti);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ITypeInfo_Release(ti);
+    ref = ITypeLib_Release(tl);
+    ok(!ref, "Got refcount %lu.\n", ref);
+
+    /* another library written to the same file is read, not the released one */
+    ok(DeleteFileA(filenameA), "Failed to delete %s, error %lu.\n", filenameA, GetLastError());
+    write_reload_typelib(filenameW, &guid2, 3);
+    hr = LoadTypeLib(filenameW, &tl);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(ITypeLib_GetTypeInfoCount(tl) == 3, "Got %u type infos.\n", ITypeLib_GetTypeInfoCount(tl));
+    ti = (void *)0xdeadbeef;
+    hr = ITypeLib_GetTypeInfoOfGuid(tl, &guid1, &ti);
+    ok(hr == TYPE_E_ELEMENTNOTFOUND, "Got hr %#lx.\n", hr);
+    hr = ITypeLib_GetTypeInfoOfGuid(tl, &guid2, &ti);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ITypeInfo_Release(ti);
+    ref = ITypeLib_Release(tl);
+    ok(!ref, "Got refcount %lu.\n", ref);
+
+    ok(DeleteFileA(filenameA), "Failed to delete %s, error %lu.\n", filenameA, GetLastError());
+}
