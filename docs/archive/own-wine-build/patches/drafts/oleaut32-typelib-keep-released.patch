+static ULONG WINAPI ITypeLib2_fnRelease( ITypeLib2 *iface)
+{
+    ITypeLibImpl *This = impl_from_ITypeLib2(iface);
+    ULONG ref;
+
+    EnterCriticalSection(&cache_section);
+    ref = InterlockedDecrement(&This->ref);
+
+    TRACE("%p, refcount %lu.\n", iface, ref);
+
+    if (!ref)
+    {
+        if (This->path && This->reusable)
+        {
+            TLBImpLib *implib;
+
+            /* keep it; the least recently released one goes */
+            TRACE("keeping released %p\n", This);
+            /* it holds nothing: imported libraries are loaded again when used */
+            LIST_FOR_EACH_ENTRY(implib, &This->implib_list, TLBImpLib, entry)
+            {
+                if (!implib->pImpTypeLib) continue;
+                ITypeLib2_Release(&implib->pImpTypeLib->ITypeLib2_iface);
+                implib->pImpTypeLib = NULL;
+            }
+            This->released = TRUE;
+            list_add_head(&released_tlbs, &This->released_entry);
+            if (++released_count > MAX_RELEASED_TLBS)
+                ITypeLibImpl_Destroy(LIST_ENTRY(list_tail(&released_tlbs), ITypeLibImpl, released_entry));
+        }
+        else
+            ITypeLibImpl_Destroy(This);
     }
 
