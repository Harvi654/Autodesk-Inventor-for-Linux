+/* user-mode driver names (D3D9, D3D10, D3D11, D3D12) as a REG_MULTI_SZ, the way
+ * the vendors' drivers register them; applications read them for diagnostics
+ * and to check the driver version */
+static const char* driver_vendor_to_umd_names( UINT16 vendor, unsigned int *len )
+{
+    static const char amd[] = "aticfx64\0aticfx64\0aticfx64\0amdxc64\0";
+    static const char nvidia[] = "nvldumdx\0nvldumdx\0nvldumdx\0nvldumdx\0";
+    static const char intel[] = "igdumdim64\0igd10iumd64\0igd10iumd64\0igd12umd64\0";
+
+    switch (vendor)
+    {
+    case 0x1002: *len = sizeof(amd); return amd;
+    case 0x10de: *len = sizeof(nvidia); return nvidia;
+    case 0x8086: *len = sizeof(intel); return intel;
+    default:     *len = 0; return NULL;
+    }
+}
