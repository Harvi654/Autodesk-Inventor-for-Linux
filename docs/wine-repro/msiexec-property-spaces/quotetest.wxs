<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal MSI for the msiexec quoting test: installs marker.txt to
     INSTALLDIR (default C:\Program Files\QuoteTest). Build: wixl quotetest.wxs -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="QuoteTest" Language="1033" Version="1.0.0" Manufacturer="winum test"
           UpgradeCode="0c6e689b-a3c5-4096-8f81-09009943abc8">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"/>
    <Media Id="1" Cabinet="quotetest.cab" EmbedCab="yes"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="QuoteTest">
          <Component Id="Marker" Guid="55a99563-65e1-4a85-966d-cda3df0f42b7">
            <File Id="MarkerFile" Name="marker.txt" Source="marker.txt" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1"><ComponentRef Id="Marker"/></Feature>
  </Product>
</Wix>
