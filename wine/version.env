# The Wine this project uses: a winum release - vanilla Wine with the patches
# of https://github.com/Harvi654/winum (patches/series there), built and
# published by winum's "Build Wine" workflow from a signed tag.
#   scripts/get-wine.sh  downloads winum-<version>-<build>-x86_64.tar.xz and
#                        checks it against wine/SHA256SUMS
#   nix/wine.nix         builds the same series from the same tag
# WINUM_VERSION: the upstream Wine version of the release.
# WINUM_BUILD:   winum's build number for it. Release: winum-$WINUM_VERSION-$WINUM_BUILD
# Until winum-11.20-1 this project built its own Wine (WINE_VERSION=11.20,
# WINE_BUILD=6, wine-inventor-11.20-6); see docs/archive/own-wine-build/.
WINUM_VERSION=11.20
WINUM_BUILD=2
