+static BOOL is_word_char( WCHAR c )
+{
+    return iswalnum( c ) || c == '_';
+}
+
+/* SCF_WORD with an empty selection formats the word only when the insertion
+   point is inside it, not when it is just before or after it. */
+static BOOL cursor_inside_word( ME_TextEditor *editor )
+{
+    int ofs = ME_GetCursorOfs( &editor->pCursors[0] );
+    ME_Cursor cursor;
+    WCHAR buf[4];
+
+    if (ofs < 1) return FALSE;
+    cursor_from_char_ofs( editor, ofs - 1, &cursor );
+    if (ME_GetTextW( editor, buf, ARRAY_SIZE(buf), &cursor, 2, FALSE, FALSE ) < 2) return FALSE;
+    return is_word_char( buf[0] ) && is_word_char( buf[1] );
+}
