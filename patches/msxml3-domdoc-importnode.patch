+/* IXMLDOMDocument3::importNode(): a copy of a node, possibly from another
+   document, that belongs to 'doc' and has no parent yet. */
+HRESULT node_import(struct domnode *doc, struct domnode *node, VARIANT_BOOL deep, IXMLDOMNode **out)
+{
+    struct domnode *cloned_node;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+
+    *out = NULL;
+
+    if (node->type == NODE_DOCUMENT)
+        return E_FAIL;
+
+    if (FAILED(hr = node_clone_domnode(node, !!deep, &cloned_node)))
+        return hr;
+
+    domnode_set_owner(cloned_node, doc);
+
+    if (FAILED(hr = create_node(cloned_node, out)))
+        domnode_destroy_tree(cloned_node);
+
+    return hr;
+}
