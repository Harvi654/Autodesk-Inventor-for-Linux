+static void test_importNode(void)
+{
+    IXMLDOMDocument3 *doc, *doc2;
+    IXMLDOMNode *node, *imported, *parent, *appended;
+    IXMLDOMElement *root;
+    IXMLDOMDocument *owner;
+    VARIANT_BOOL b;
+    HRESULT hr;
+    BSTR str;
+
+    if (!is_clsid_supported(&CLSID_DOMDocument60, &IID_IXMLDOMDocument3)) return;
+    doc = create_document_version(60, &IID_IXMLDOMDocument3);
+    doc2 = create_document_version(60, &IID_IXMLDOMDocument3);
+
+    hr = IXMLDOMDocument3_loadXML(doc, _bstr_("<a x=\"1\"><b>t</b></a>"), &b);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument3_get_documentElement(doc, &root);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMElement_QueryInterface(root, &IID_IXMLDOMNode, (void **)&node);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMElement_Release(root);
+
+    /* shallow: the attributes, no children */
+    hr = IXMLDOMDocument3_importNode(doc2, node, VARIANT_FALSE, &imported);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNode_get_xml(imported, &str);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!wcsncmp(str, L"<a x=\"1\"", 8) && !wcsstr(str, L"<b>"), "Unexpected xml %s.\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+    IXMLDOMNode_Release(imported);
+
+    /* deep */
+    hr = IXMLDOMDocument3_importNode(doc2, node, VARIANT_TRUE, &imported);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMNode_Release(node);
+    /* the source document is not needed any more */
+    IXMLDOMDocument3_Release(doc);
+
+    parent = (void *)0xdeadbeef;
+    hr = IXMLDOMNode_get_parentNode(imported, &parent);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    ok(!parent, "Unexpected parent %p.\n", parent);
+
+    /* owned by the (still empty) importing document, not by the source */
+    hr = IXMLDOMNode_get_ownerDocument(imported, &owner);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    root = (void *)0xdeadbeef;
+    hr = IXMLDOMDocument_get_documentElement(owner, &root);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    ok(!root, "Unexpected document element %p.\n", root);
+    IXMLDOMDocument_Release(owner);
+
+    hr = IXMLDOMDocument3_appendChild(doc2, imported, &appended);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMNode_Release(appended);
+    IXMLDOMNode_Release(imported);
+
+    hr = IXMLDOMDocument3_get_xml(doc2, &str);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!wcsncmp(str, L"<a x=\"1\"><b>t</b></a>", 21), "Unexpected xml %s.\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    IXMLDOMDocument3_Release(doc2);
+    free_bstrs();
+}
