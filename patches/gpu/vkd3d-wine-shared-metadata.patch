+#ifdef _WIN32
+/* Wine upstream stores runtime texture descriptors on its D3DKMT resource.
+ * Keep the Proton IOCTL path first, and use this channel when it is absent. */
+static bool vkd3d_set_wine_shared_metadata(HANDLE handle, const LUID *luid, const void *buf, uint32_t buf_size)
+{
+    struct {
+        UINT size, version, width, height, format, unknown0, unknown1;
+        UINT keyed_mutex, mutex_handle, sync_handle, nt_shared, unknown2, unknown3, unknown4;
+        UINT dimension;
+        UINT texture_desc[11];
