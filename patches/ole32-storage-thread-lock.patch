+static void test_threads(void)
+{
+    struct thread_storage_param params[4];
+    HANDLE threads[4];
+    IStorage *stg;
+    HRESULT hr;
+    int i;
+
+    DeleteFileW(filename);
+    hr = StgCreateDocfile(filename, STGM_CREATE | STGM_READWRITE | STGM_SHARE_EXCLUSIVE | STGM_TRANSACTED, 0, &stg);
+    ok(hr == S_OK, "StgCreateDocfile failed, hr %#lx\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(threads); i++)
+    {
+        params[i].root = stg;
+        params[i].id = i;
+        params[i].failures = 0;
+        threads[i] = CreateThread(NULL, 0, thread_storage_proc, &params[i], 0, NULL);
+        ok(threads[i] != NULL, "CreateThread failed\n");
+    }
+    WaitForMultipleObjects(ARRAY_SIZE(threads), threads, TRUE, INFINITE);
+    for (i = 0; i < ARRAY_SIZE(threads); i++)
+    {
+        CloseHandle(threads[i]);
+        ok(!params[i].failures, "thread %d: %ld failures\n", i, params[i].failures);
+    }
+
+    hr = IStorage_Commit(stg, 0);
+    ok(hr == S_OK, "Commit failed, hr %#lx\n", hr);
+    IStorage_Release(stg);
+    DeleteFileW(filename);
+}
