+
+static DWORD WINAPI thread_storage_proc(void *arg)
+{
+    struct thread_storage_param *param = arg;
+    BYTE buffer[9000], check[9000];
+    LARGE_INTEGER zero = {{0}};
+    IStorage *stg;
+    IStream *stm;
+    ULONG len, i, read;
+    WCHAR name[16];
+    HRESULT hr;
+    int round;
+
+    for (round = 0; round < 20; round++)
+    {
+        swprintf(name, ARRAY_SIZE(name), L"T%d_%d", param->id, round % 4);
+        hr = IStorage_CreateStorage(param->root, name, STGM_READWRITE | STGM_SHARE_EXCLUSIVE | STGM_TRANSACTED | STGM_CREATE,
+                0, 0, &stg);
+        if (FAILED(hr))
+        {
+            param->failures++;
+            continue;
+        }
+        hr = IStorage_CreateStream(stg, L"DATA", STGM_READWRITE | STGM_SHARE_EXCLUSIVE | STGM_CREATE, 0, 0, &stm);
+        if (FAILED(hr))
+        {
+            param->failures++;
+            IStorage_Release(stg);
+            continue;
+        }
+
+        len = 100 + (round * 997 + param->id * 331) % 8500;
+        for (i = 0; i < len; i++)
+            buffer[i] = i * 7 + param->id + round;
+        /* small writes, so that the stream moves from small to big blocks */
+        for (i = 0; i < len; i += 300)
+            IStream_Write(stm, buffer + i, min(300, len - i), NULL);
+        IStream_Seek(stm, zero, STREAM_SEEK_SET, NULL);
+        hr = IStream_Read(stm, check, len, &read);
+        if (FAILED(hr) || read != len || memcmp(buffer, check, len))
+            param->failures++;
+
+        IStream_Release(stm);
+        if (FAILED(IStorage_Commit(stg, 0)))
+            param->failures++;
+        IStorage_Release(stg);
+    }
+    return 0;
+}
