+/* Experimental bridge for opaque software child windows owned by another process.
+ * Original AI-assisted implementation, LGPL-2.1-or-later. */
+static BOOL foreign_surface_flush( struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                                   const BITMAPINFO *info, const void *bits, BOOL shape_changed,
+                                   const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    unsigned char buffer[FOREIGN_SURFACE_BLIT_MAX];
+    struct foreign_surface_blit *blit = (struct foreign_surface_blit *)buffer;
+    struct foreign_surface *foreign = (struct foreign_surface *)surface;
+    RECT area;
+    UINT index;
+    int x, y, row, width, height, stride = info->bmiHeader.biWidth * 4;
+    SIZE_T size;
+
+    if (info->bmiHeader.biBitCount != 32 || info->bmiHeader.biHeight >= 0 || shape_bits) return FALSE;
+    for (index = 0; index < foreign->clip_count; index++)
+    {
+      if (!intersect_rect(&area, dirty, &foreign->clip_rects[index])) continue;
+      for (y = area.top; y < area.bottom; y += height)
+      {
+        height = min(16, area.bottom - y);
+        for (x = area.left; x < area.right; x += width)
+        {
+            width = min(240, area.right - x);
+            SetRect(&blit->rect, x + rect->left, y + rect->top,
+                    x + rect->left + width, y + rect->top + height);
+            for (row = 0; row < height; row++)
+                memcpy(blit->bits + row * width * 4, (const BYTE *)bits + (y + row) * stride + x * 4,
+                       width * 4);
+            size = FIELD_OFFSET(struct foreign_surface_blit, bits) + width * height * 4;
+            if (!send_message_timeout(surface->hwnd, WM_WINE_SURFACE_BLIT, size, (LPARAM)blit,
+                                      SMTO_BLOCK | SMTO_ABORTIFHUNG, 1000, FALSE)) return FALSE;
+        }
+      }
+    }
+    return TRUE;
+}
+
+static void foreign_surface_destroy( struct window_surface *surface )
+{
+    free(((struct foreign_surface *)surface)->clip_rects);
+}
+
+static const struct window_surface_funcs foreign_surface_funcs =
+{
+    .size = sizeof(struct foreign_surface),
+    .set_clip = offscreen_window_surface_set_clip,
+    .flush = foreign_surface_flush,
+    .destroy = foreign_surface_destroy
+};
+
+static struct window_surface *create_foreign_surface( HWND hwnd, const RECT *top_rect, HRGN clip )
+{
+    BITMAPINFO info = {{0}};
+    struct window_surface *surface;
+    struct foreign_surface *foreign;
+    WINEREGION *region;
+    RECT rect;
+    UINT i;
+    int width, height;
+
+    if (top_rect->right <= top_rect->left || top_rect->bottom <= top_rect->top ||
+        (LONGLONG)top_rect->right - top_rect->left > 16384 ||
+        (LONGLONG)top_rect->bottom - top_rect->top > 16384) return NULL;
+    width = top_rect->right - top_rect->left;
+    height = top_rect->bottom - top_rect->top;
+
+    if (width <= 0 || height <= 0 || width > 16384 || height > 16384 ||
+        (SIZE_T)width * height > 16777216) return NULL;
+    SetRect(&rect, 0, 0, width, height);
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biSizeImage = width * height * 4;
+    info.bmiHeader.biCompression = BI_RGB;
+    if (!(surface = window_surface_create(&foreign_surface_funcs, hwnd, &rect, &info, 0))) return NULL;
+    foreign = (struct foreign_surface *)surface;
+    if ((region = GDI_GetObjPtr(clip, NTGDI_OBJ_REGION)))
+    {
+        foreign->clip_count = region->numRects;
+        foreign->clip_rects = malloc(region->numRects * sizeof(RECT));
+        if (foreign->clip_rects)
+            for (i = 0; i < region->numRects; i++)
+            {
+                foreign->clip_rects[i] = region->rects[i];
+                OffsetRect(&foreign->clip_rects[i], -top_rect->left, -top_rect->top);
+            }
+        else foreign->clip_count = 0;
+        GDI_ReleaseObj(clip);
+    }
+    register_window_surface(NULL, surface);
+    return surface;
+}
+
+LRESULT receive_surface_blit( HWND hwnd, const struct foreign_surface_blit *blit, SIZE_T size )
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *surface = NULL;
+    RECT dirty;
+    BYTE *bits;
+    WND *win;
+    int width, height, x, y, row, stride;
+    BOOL valid = FALSE;
+
+    if (size < FIELD_OFFSET(struct foreign_surface_blit, bits)) return FALSE;
+    if (blit->rect.left < 0 || blit->rect.top < 0 ||
+        blit->rect.right > 16384 || blit->rect.bottom > 16384 ||
+        blit->rect.left >= blit->rect.right || blit->rect.top >= blit->rect.bottom) return FALSE;
+    width = blit->rect.right - blit->rect.left;
+    height = blit->rect.bottom - blit->rect.top;
+    if (width <= 0 || width > 240 || height <= 0 || height > 16 ||
+        size != FIELD_OFFSET(struct foreign_surface_blit, bits) + width * height * 4) return FALSE;
+    if (!(win = get_win_ptr(hwnd)) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return FALSE;
+    if ((surface = win->surface)) window_surface_add_ref(surface);
+    release_win_ptr(win);
+    if (!surface || surface == &dummy_surface) goto done;
+    window_surface_lock(surface);
+    x = blit->rect.left - surface->rect.left;
+    y = blit->rect.top - surface->rect.top;
+    if ((bits = window_surface_get_color(surface, info)) && info->bmiHeader.biBitCount == 32 &&
+        info->bmiHeader.biHeight < 0 && x >= 0 && y >= 0 &&
+        x <= info->bmiHeader.biWidth - width && y <= -info->bmiHeader.biHeight - height)
+    {
+        stride = info->bmiHeader.biWidth * 4;
+        for (row = 0; row < height; row++)
+            memcpy(bits + (y + row) * stride + x * 4, blit->bits + row * width * 4, width * 4);
+        SetRect(&dirty, x, y, x + width, y + height);
+        union_rect(&surface->bounds, &surface->bounds, &dirty);
+        valid = TRUE;
+    }
+    window_surface_unlock(surface);
+    if (valid) window_surface_flush(surface);
+ done:
+    if (surface) window_surface_release(surface);
+    return valid;
+}
+
+static void release_foreign_surface( struct dce *dce )
+{
+    struct window_surface *surface = dce->foreign_surface;
+    dce->foreign_surface = NULL;
+    if (!surface) return;
+    register_window_surface(surface, NULL);
+    window_surface_flush(surface);
+    window_surface_release(surface);
+}
+
+static void destroy_dce_storage( struct dce *dce )
+{
+    release_foreign_surface(dce);
+    free(dce);
 }
 
