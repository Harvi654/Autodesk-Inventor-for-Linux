# Copy to config.env (gitignored) and adjust. Every value is optional.
#WIN_ROOT=/mnt/windows            # mounted Windows partition
#WIN_USER=YourWindowsUser         # profile to copy Inventor settings from
#INV_YEAR=2026
#INV_PREFIX=$HOME/.wine-inventor2026
#ASC_VER=1.8.0                    # force a Shared Components version
#LIC_VER=15.4.2.4                 # force an AdskLicensing version
#INV_DATA_DIR=$HOME/Inventor      # your files, mapped as D: (empty = no D:)
#INV_SANDBOX=1                    # 0 = Wine defaults (Z: = /, $HOME links)
#INV_DXVK=pinned                  # or "system" to use setup_dxvk from a package
